 static mp_obj_t set_binary_op(mp_binary_op_t op, mp_obj_t lhs, mp_obj_t rhs) {
+    if (op != MP_BINARY_OP_CONTAINS && !is_set_or_frozenset(rhs)) {
+        // an instance of a set subclass takes part as the set it holds
+        mp_obj_t native = mp_obj_cast_to_native_base(rhs, MP_OBJ_FROM_PTR(&mp_type_set));
+        #if MICROPY_PY_BUILTINS_FROZENSET
+        if (native == MP_OBJ_NULL) {
+            native = mp_obj_cast_to_native_base(rhs, MP_OBJ_FROM_PTR(&mp_type_frozenset));
+        }
+        #endif
+        if (native != MP_OBJ_NULL) {
+            rhs = native;
+        }
+    }
     mp_obj_t args[] = {lhs, rhs};
     #if MICROPY_PY_BUILTINS_FROZENSET
     bool update = mp_obj_is_type(lhs, &mp_type_set);
