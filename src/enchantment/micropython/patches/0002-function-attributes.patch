 }
 
 #if MICROPY_PY_FUNCTION_ATTRS
+static mp_obj_dict_t *fun_bc_dict(mp_obj_fun_bc_t *self) {
+    if (self->dict == NULL) {
+        self->dict = MP_OBJ_TO_PTR(mp_obj_new_dict(0));
+    }
+    return self->dict;
+}
+
 void mp_obj_fun_bc_attr(mp_obj_t self_in, qstr attr, mp_obj_t *dest) {
+    mp_obj_fun_bc_t *self = MP_OBJ_TO_PTR(self_in);
     if (dest[0] != MP_OBJ_NULL) {
-        // not load attribute
+        // store or delete: functions take any attribute, as in CPython,
+        // except the ones computed below, which stay read-only
+        if (attr == MP_QSTR___name__ || attr == MP_QSTR___globals__ || attr == MP_QSTR___dict__
+            #if MICROPY_PY_FUNCTION_ATTRS_CODE
+            || attr == MP_QSTR___code__
+            #endif
+            ) {
+            return;
+        }
+        if (dest[1] != MP_OBJ_NULL) {
+            mp_obj_dict_store(MP_OBJ_FROM_PTR(fun_bc_dict(self)), MP_OBJ_NEW_QSTR(attr), dest[1]);
+            dest[0] = MP_OBJ_NULL;
+        } else if (self->dict != NULL
+                   && mp_map_lookup(&self->dict->map, MP_OBJ_NEW_QSTR(attr), MP_MAP_LOOKUP_REMOVE_IF_FOUND) != NULL) {
+            dest[0] = MP_OBJ_NULL;
+        }
+        return;
+    }
+    if (attr == MP_QSTR___dict__) {
+        dest[0] = MP_OBJ_FROM_PTR(fun_bc_dict(self));
         return;
     }
-    const mp_obj_fun_bc_t *self = MP_OBJ_TO_PTR(self_in);
+    if (self->dict != NULL) {
+        mp_map_elem_t *elem = mp_map_lookup(&self->dict->map, MP_OBJ_NEW_QSTR(attr), MP_MAP_LOOKUP);
+        if (elem != NULL) {
+            dest[0] = elem->value;
+            return;
+        }
+    }
     if (attr == MP_QSTR___name__) {
         dest[0] = MP_OBJ_NEW_QSTR(mp_obj_fun_bc_get_name(self));
     }
