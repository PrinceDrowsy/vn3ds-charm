--- a/py/objstr.c
+++ b/py/objstr.c
@@ -601,7 +601,15 @@ static mp_obj_t bytes_subscr(mp_obj_t self_in, mp_obj_t index, mp_obj_t value) {
         if (mp_obj_is_type(index, &mp_type_slice)) {
             mp_bound_slice_t slice;
             if (!mp_seq_get_fast_slice_indexes(self_len, index, &slice)) {
-                mp_raise_NotImplementedError(MP_ERROR_TEXT("only slices with step=1 (aka None) are supported"));
+                // a step other than 1, walked as mp_seq_extract_slice does
+                vstr_t vstr;
+                vstr_init(&vstr, 16);
+                mp_int_t i = slice.start;
