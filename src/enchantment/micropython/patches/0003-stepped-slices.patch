diff --git a/py/objstrunicode.c b/py/objstrunicode.c
index fc51166..80370c1 100644
--- a/py/objstrunicode.c
+++ b/py/objstrunicode.c
@@ -203,7 +203,30 @@ static mp_obj_t str_subscr(mp_obj_t self_in, mp_obj_t index, mp_obj_t value) {
             ostep = slice->step;
 
             if (ostep != mp_const_none && ostep != MP_OBJ_NEW_SMALL_INT(1)) {
-                mp_raise_NotImplementedError(MP_ERROR_TEXT("only slices with step=1 (aka None) are supported"));
+                // a step other than 1: index the characters, then walk them
+                // as mp_seq_extract_slice does
+                size_t n = utf8_charlen(self_data, self_len);
+                const byte **chars = m_new(const byte *, n + 1);
+                const byte *p = self_data;
+                for (size_t c = 0; c < n; c++) {
+                    chars[c] = p;
+                    ++p;
+                    while (UTF8_IS_CONT(*p)) {
+                        ++p;
+                    }
+                }
+                chars[n] = self_data + self_len;
+                mp_bound_slice_t bound;
+                mp_seq_get_fast_slice_indexes(n, index, &bound);
+                vstr_t vstr;
+                vstr_init(&vstr, 16);
+                mp_int_t c = bound.start;
+                while (bound.step < 0 ? c >= bound.stop : c < bound.stop) {
+                    vstr_add_strn(&vstr, (const char *)chars[c], chars[c + 1] - chars[c]);
+                    c += bound.step;
+                }
+                m_del(const byte *, chars, n + 1);
+                return mp_obj_new_str_from_vstr(&vstr);
             }
 
             const byte *pstart, *pstop;
